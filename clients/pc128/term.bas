10 REM RETROSSH TERMINAL - OLIVETTI PRODEST PC128 (BASIC 128)
20 REM SERIAL I/O LIVES IN LINES 1000-1299: ADAPT IT TO YOUR RS232 INTERFACE
30 REM F1 = WIFI SETUP, F2 = ESC, F10 = QUIT
35 REM SET THE F-KEY CODES IN LINE 60: RUN 3000 SHOWS THE CODE OF ANY KEY
40 CLS:GOSUB 1000
50 PRINT "RETROSSH TERMINAL - F1 WIFI SETUP, F10 QUITS"
60 F1=-1:F2=-1:F0=-1
100 K$=INKEY$
110 IF K$<>"" THEN GOSUB 500
120 GOSUB 1100
130 IF R$<>"" THEN GOSUB 300
140 GOTO 100
300 REM --- RECEIVED CHARACTER ---
310 C=ASC(R$)
320 IF C>31 AND C<127 THEN PRINT R$;:RETURN
330 IF C=13 OR C=10 OR C=8 OR C=7 THEN PRINT CHR$(C);
340 RETURN
500 REM --- KEY PRESSED ---
510 K=ASC(K$)
520 IF K=F0 THEN GOSUB 1300:END
530 IF K=F1 THEN GOSUB 2000:RETURN
540 IF K=F2 THEN K=27
550 KO=K:GOSUB 1200
560 RETURN
1000 REM --- SERIAL INIT: OPEN THE RS232 CHANNEL AT THE MODEM BAUD RATE ---
1010 REM SEE THE MANUAL OF YOUR INTERFACE (E.G. THOMSON CC 90-232)
1020 RETURN
1100 REM --- SERIAL READ: R$ = ONE RECEIVED CHAR, OR "" IF NONE (NON-BLOCKING) ---
1110 R$=""
1120 RETURN
1200 REM --- SERIAL WRITE: SEND THE CHARACTER WITH CODE KO ---
1210 RETURN
1300 REM --- SERIAL CLOSE ---
1310 RETURN
2000 REM --- WIFI SETUP ---
2010 PRINT:LINE INPUT "SSID: ";WS$
2020 IF WS$="" THEN RETURN
2030 LINE INPUT "PASSPHRASE: ";WP$
2040 LINE INPUT "RTS/CTS WIRED (Y/N)? ";WF$
2050 PRINT "CONFIGURING MODEM..."
2055 REM +++ WITH GUARD TIMES REACHES COMMAND MODE EVEN IF A SESSION IS OPEN
2060 GOSUB 2700:A$="+++":GOSUB 2600:GOSUB 2700:A$=CHR$(13):GOSUB 2600
2070 E$=WS$:GOSUB 2500:A$="AT+CWJAP="+E$
2080 E$=WP$:GOSUB 2500:A$=A$+","+E$+CHR$(13):GOSUB 2600
2090 A$="AT+TERM=dumb"+CHR$(13):GOSUB 2600
2100 A$="AT+FILTER=1"+CHR$(13):GOSUB 2600
2110 A$="AT+WIN=40,25"+CHR$(13):GOSUB 2600
2120 IF WF$="Y" OR WF$="y" THEN A$="AT&K3"+CHR$(13):GOSUB 2600
2130 A$="AT&W"+CHR$(13):GOSUB 2600
2140 PRINT "SENT. JOINING TAKES UP TO 20S: CHECK WITH AT+CWJAP?"
2150 RETURN
2500 REM --- QUOTE E$, ESCAPING " AND \ ---
2510 T$=CHR$(34)
2520 FOR I=1 TO LEN(E$)
2530 C$=MID$(E$,I,1):IF C$=CHR$(34) OR C$=CHR$(92) THEN T$=T$+CHR$(92)
2540 T$=T$+C$:NEXT I
2550 E$=T$+CHR$(34):RETURN
2600 FOR I=1 TO LEN(A$):KO=ASC(MID$(A$,I,1)):GOSUB 1200:NEXT I:RETURN
2700 REM --- WAIT AT LEAST 1 S: TUNE THE COUNT ON YOUR MACHINE ---
2710 FOR I=1 TO 2000:NEXT I:RETURN
3000 REM --- KEY-CODE FINDER: PRESS KEYS, STOP TO END ---
3010 CLS:PRINT "PRESS A KEY (STOP ENDS)"
3020 K$=INKEY$:IF K$="" THEN 3020
3030 PRINT ASC(K$);
3040 K$=INKEY$:IF K$<>"" THEN 3030
3050 PRINT:GOTO 3020
